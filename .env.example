# GEMINI_API_KEY: Optional for Gemini AI calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TELEGRAM_BOT_TOKEN: Used to verify Telegram WebApp initData HMAC-SHA256 signature
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# COOKIE_VAULT_KEY: 32-byte AES-256-GCM encryption key (Base64 encoded) for Cookie Vault at rest
COOKIE_VAULT_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# TARGET_ORIGIN: Origin target for the reverse proxy (default: https://m.facebook.com)
TARGET_ORIGIN="https://m.facebook.com"

# RESIDENTIAL_PROXY_URL: Optional rotating residential/mobile proxy exit node
RESIDENTIAL_PROXY_URL=""

